<Window x:Class="CrosshairApp.Views.EditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="{DynamicResource S.AppName}" Width="{DynamicResource ShellWidth}" Height="{DynamicResource ShellHeight}" MinWidth="980" MinHeight="620" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource BodyFont}" FontSize="{DynamicResource BodySize}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Border Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
  <Grid x:Name="ShellRoot">
   <Grid.RowDefinitions><RowDefinition Height="{DynamicResource TitleRow}"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="{DynamicResource RailColumn}"/><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource InspectorColumn}"/></Grid.ColumnDefinitions>
   <Border Grid.ColumnSpan="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"><DockPanel x:Name="TitleHost" Margin="16,0,6,0"/></Border>
   <Border Grid.Row="1" Grid.RowSpan="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0"><DockPanel x:Name="RailHost"/></Border>
   <Grid x:Name="StageHost" Grid.Row="1" Grid.Column="1" Margin="16,0,16,0"/>
   <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0"><DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="16,16,16,12"><TextBlock x:Name="InspectorTitle" FontFamily="{DynamicResource LabelFont}" FontSize="{DynamicResource HeadingSize}"/></StackPanel>
    <ScrollViewer x:Name="InspectorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="InspectorBody" Margin="16,0,16,16"/></ScrollViewer>
   </DockPanel></Border>
   <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"><TextBlock x:Name="StatusText" Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" FontFamily="{DynamicResource NumberFont}" FontSize="{DynamicResource LabelSize}" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis"/></Border>
  </Grid>
 </Border>
</Window>


