<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AIMORA</AssemblyName>
    <RootNamespace>CrosshairApp</RootNamespace>
    <Product>AIMORA</Product>
    <Title>AIMORA</Title>
    <!-- WPF owns DPI initialization; WinForms is used only for tray/dialog helpers. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="presets.json" /></ItemGroup>
  <ItemGroup><Resource Include="Assets\Fonts\*.ttf" /><Resource Include="Assets\Fonts\*.txt" /></ItemGroup>
</Project>
